{
  "name": "fireguardians",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node aspnetcore-https",
    "start": "run-script-os",
    "start:windows": "ng serve --port 44486 --host=0.0.0.0 --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\"",
    "start:default": "ng serve --port 44486 --host=0.0.0.0 --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "postinstall": "node src/environments/version.ts",
    "codegen": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 graphql-codegen --config codegen.yml",
    "codegen:check": "graphql-codegen --config codegen.yml && git diff --exit-code -- src/app/graphQL && test -z \"$(git status --porcelain -- src/app/graphQL)\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/google-maps": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/service-worker": "^22.3.0",
    "@apollo/client": "^4.3.8",
    "@meshmakers/octo-services": "^3.5.790",
    "@meshmakers/shared-auth": "^3.5.790",
    "@meshmakers/shared-services": "^3.5.790",
    "@meshmakers/shared-ui": "^3.5.790",
    "@meshmakers/shared-ui-legacy": "^3.5.790",
    "@progress/kendo-angular-buttons": "24.2.2",
    "@progress/kendo-angular-common": "24.2.2",
    "@progress/kendo-angular-conversational-ui": "24.2.2",
    "@progress/kendo-angular-dateinputs": "24.2.2",
    "@progress/kendo-angular-dialog": "24.2.2",
    "@progress/kendo-angular-dropdowns": "24.2.2",
    "@progress/kendo-angular-excel-export": "24.2.2",
    "@progress/kendo-angular-grid": "24.2.2",
    "@progress/kendo-angular-icons": "24.2.2",
    "@progress/kendo-angular-indicators": "24.2.2",
    "@progress/kendo-angular-inputs": "24.2.2",
    "@progress/kendo-angular-intl": "24.2.2",
    "@progress/kendo-angular-l10n": "24.2.2",
    "@progress/kendo-angular-label": "24.2.2",
    "@progress/kendo-angular-layout": "24.2.2",
    "@progress/kendo-angular-menu": "24.2.2",
    "@progress/kendo-angular-navigation": "24.2.2",
    "@progress/kendo-angular-notification": "24.2.2",
    "@progress/kendo-angular-pager": "24.2.2",
    "@progress/kendo-angular-pdf-export": "24.2.2",
    "@progress/kendo-angular-popup": "24.2.2",
    "@progress/kendo-angular-progressbar": "24.2.2",
    "@progress/kendo-angular-toolbar": "24.2.2",
    "@progress/kendo-angular-treeview": "24.2.2",
    "@progress/kendo-angular-upload": "24.2.2",
    "@progress/kendo-angular-utils": "24.2.2",
    "@progress/kendo-data-query": "1.7.4",
    "@progress/kendo-drawing": "1.25.7",
    "@progress/kendo-licensing": "1.13.1",
    "@progress/kendo-svg-icons": "^4.12.0",
    "@progress/kendo-theme-default": "^14.10.1",
    "angular-oauth2-oidc": "^22.0.0",
    "apollo-angular": "^14.1.0",
